# Python / uv
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Pretrained and trained model weights
weights/*
!weights/.gitkeep

# Data may be large or governed by its source license. Keep only manifests here.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated experiment runs and artefacts
experiments/**/*
!experiments/**/logs/
!experiments/*/logs/.gitkeep
!experiments/**/figures/
!experiments/**/figures/.gitkeep

# Aggregated generated results
results/metrics/*
!results/metrics/.gitkeep
results/figures/*
!results/figures/.gitkeep

*.zip
*.pt
